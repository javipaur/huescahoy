# Contraseña del panel de administración (/admin)
ADMIN_PASSWORD=changeme

# Conexión a PostgreSQL (Dokploy)
# Ejemplo: postgresql://usuario:contraseña@host:5432/huescahoybd
DATABASE_URL=

# URL pública del sitio (para enlaces canónicos y calendario)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: tiempo máximo de espera (ms) al hacer scraping de fuentes
# SCRAPER_TIMEOUT_MS=15000

# PostHog: analítica de visitas y monitorización de errores
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Notificaciones push (Web Push / VAPID)
# Genera el par de claves con: npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BBbb...
# VAPID_PRIVATE_KEY=ssss...
# VAPID_SUBJECT=mailto:tu@correo.es

# Secreto para el resumen diario (/api/cron/digest). Úsalo también en tu servicio
# de tareas programadas (cron-job.org, UptimeRobot, Dokploy...) llamando a:
# POST https://tu-dominio/api/cron/digest con cabecera Authorization: Bearer <secreto>
# CRON_SECRET=genera-un-secreto

# Avisos por correo cuando alguien envía una sugerencia o un evento desde /colabora.
# Opción A (recomendada): cuenta de Gmail con contraseña de aplicación.
# 1) Activa la verificación en dos pasos de tu cuenta de Google.
# 2) Crea una contraseña de aplicación: https://myaccount.google.com/apppasswords
# 3) NOTIFY_EMAIL es tu buzón: ahí llegan los avisos.
# EMAIL_USER=tu@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx
# NOTIFY_EMAIL=tu@correo.es
# MAIL_FROM="Huesca Hoy <tu@gmail.com>"
#
# Opción B: Resend (https://resend.com, cuenta gratis).
# 1) Genera una API key. 2) Con la cuenta sin verificar, Resend solo permite
#    enviar desde onboarding@resend.dev (no hace falta tocar MAIL_FROM).
# RESEND_API_KEY=re_xxxx
